# Copy to .env.production and replace every CHANGE_ME value before using on a VPS.
# This file is intentionally production-oriented. For local development, use .env.example.

# REQUIRED: release image to deploy. Use a concrete release or prerelease tag, never :dev or :latest.
CYPRA_IMAGE=ghcr.io/watzon/cypra:0.1.0-rc.2

# REQUIRED: public install domain. Create A/AAAA records for this host and wildcard DNS for tenants.
CYPRA_INSTALL_DOMAIN=auth.example.com
PUBLIC_BASE_URL=https://auth.example.com

# REQUIRED for the with-tls profile: Caddy image and ACME registration email.
CADDY_IMAGE=caddy:2-alpine
CADDY_ACME_EMAIL=ops@example.com

# REQUIRED: runtime database. If using the bundled Postgres service, keep the host as postgres.
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_POSTGRES_PASSWORD
DATABASE_URL=postgres://cypra:CHANGE_ME_LONG_RANDOM_POSTGRES_PASSWORD@postgres:5432/cypra?sslmode=disable
MIGRATE_DATABASE_URL=postgres://cypra:CHANGE_ME_LONG_RANDOM_POSTGRES_PASSWORD@postgres:5432/cypra?sslmode=disable

# REQUIRED: base64, hex, or raw 32-byte master key. Generate this once and store it securely.
MASTER_KEY=CHANGE_ME_32_RANDOM_BYTES_BASE64_OR_HEX
MASTER_KEY_FILE=

# Cypra listens only inside the compose network in production.
LISTEN_ADDR=:8080

# REQUIRED behind the production Caddy reverse proxy.
TRUSTED_PROXY_HEADERS=x-forwarded

# REQUIRED: choose storage. Local disk is acceptable for a small single-host tester install only if the host volume is backed up.
STORAGE_BACKEND=local-disk
STORAGE_LOCAL_PATH=/var/lib/cypra/storage

# OPTIONAL: S3-compatible storage is preferred when local disk durability is uncertain.
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# OPTIONAL: OpenTelemetry collector endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=

# REQUIRED: use info in production. Debug exposes dev-only diagnostics such as OpenAPI output.
LOG_LEVEL=info
