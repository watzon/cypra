#!/usr/bin/env node
import { mkdir, writeFile } from "node:fs/promises";
import path from "node:path";
import process from "node:process";

import axe from "axe-core";
import { chromium } from "playwright";

function usage() {
  console.error(
    "usage: agent-browser walk <url> [--out <file>] [--color-scheme light|dark] [--viewport <width>x<height>]",
  );
}

const [, , command, url, ...args] = process.argv;

if (command !== "walk" || !url) {
  usage();
  process.exit(2);
}

let out = path.join(".agent-browser", `${Date.now()}-walk.json`);
let colorScheme = "light";
let viewport = { width: 1280, height: 720 };

for (let index = 0; index < args.length; index += 1) {
  const arg = args[index];

  if (arg === "--out" && args[index + 1]) {
    out = args[index + 1];
    index += 1;
    continue;
  }

  if (arg === "--color-scheme" && args[index + 1]) {
    colorScheme = args[index + 1];
    if (colorScheme !== "light" && colorScheme !== "dark") {
      console.error(`invalid color scheme: ${colorScheme}`);
      process.exit(2);
    }
    index += 1;
    continue;
  }

  if (arg === "--viewport" && args[index + 1]) {
    const match = /^(\d+)x(\d+)$/.exec(args[index + 1]);
    if (!match) {
      console.error(`invalid viewport: ${args[index + 1]}`);
      process.exit(2);
    }
    viewport = { width: Number(match[1]), height: Number(match[2]) };
    index += 1;
    continue;
  }

  console.error(`unknown argument: ${arg}`);
  process.exit(2);
}

const browser = await chromium.launch();

try {
  const page = await browser.newPage({ colorScheme, viewport });
  await page.goto(url, { waitUntil: "networkidle" });
  await page.addScriptTag({ content: axe.source });

  const cdp = await page.context().newCDPSession(page);
  const accessibilityTree = await cdp.send("Accessibility.getFullAXTree");
  const axeResults = await page.evaluate(async () => globalThis.axe.run());

  const result = {
    url,
    capturedAt: new Date().toISOString(),
    title: await page.title(),
    colorScheme,
    viewport,
    accessibilityTree,
    axe: axeResults,
  };

  await mkdir(path.dirname(out), { recursive: true });
  await writeFile(out, `${JSON.stringify(result, null, 2)}\n`);
  console.log(JSON.stringify({ tool: "agent-browser", status: "passed", out }));
} finally {
  await browser.close();
}
