# Runtime database URL. Use the restricted cypra_runtime role after Phase 1.
DATABASE_URL=postgres://cypra:cypra@localhost:54320/cypra?sslmode=disable

# Migration database URL. Falls back to DATABASE_URL with a warning if unset.
MIGRATE_DATABASE_URL=postgres://cypra:cypra@localhost:54320/cypra?sslmode=disable

# Base64 or raw master KEK. Set either MASTER_KEY or MASTER_KEY_FILE, never both.
MASTER_KEY=dev-only-change-me-dev-only-change-me-32b

# Path to a file containing the master KEK. Preferred for production secrets managers.
MASTER_KEY_FILE=

# HTTP bind address for cypra serve.
LISTEN_ADDR=:8080

# Public HTTPS install URL. Tenant issuers derive from this host.
PUBLIC_BASE_URL=https://cypra.localhost

# Forwarded header trust mode: none, x-forwarded, or forwarded.
TRUSTED_PROXY_HEADERS=none

# Storage backend selector: local-disk or s3-compatible.
STORAGE_BACKEND=local-disk

# Local disk storage root when STORAGE_BACKEND=local-disk.
STORAGE_LOCAL_PATH=.data/storage

# S3-compatible bucket when STORAGE_BACKEND=s3-compatible.
STORAGE_S3_BUCKET=

# S3-compatible endpoint, for example https://s3.amazonaws.com or a MinIO URL.
STORAGE_S3_ENDPOINT=

# S3-compatible region.
STORAGE_S3_REGION=

# S3-compatible access key id.
STORAGE_S3_ACCESS_KEY_ID=

# S3-compatible secret access key.
STORAGE_S3_SECRET_ACCESS_KEY=

# Optional OTLP HTTP endpoint for OpenTelemetry export.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional log level. Defaults to info.
LOG_LEVEL=info
