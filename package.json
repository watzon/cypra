{
  "name": "cypra",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "dashboard",
    "examples/nextjs"
  ],
  "scripts": {
    "build": "bun run --filter dashboard build",
    "cold-start": "node scripts/check-cold-start.mjs",
    "dev": "bun run --filter dashboard dev",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "go:coverage": "node scripts/check-go-coverage.mjs",
    "lighthouse:baseline": "node scripts/check-lighthouse-baseline.mjs",
    "lint": "bun run --filter dashboard lint && bun run lint:colors",
    "lint:colors": "node scripts/check-no-hardcoded-colors.mjs",
    "test": "bun run --filter dashboard test",
    "test:e2e": "playwright test",
    "typecheck": "bun run --filter dashboard typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.10.1",
    "axe-core": "^4.11.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.39.1",
    "lighthouse": "^13.3.0",
    "playwright": "^1.59.1",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.4"
  }
}
